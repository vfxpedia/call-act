# ============================================================
# 로컬 개발 환경 설정 예시 (WSL + vLLM)
# ============================================================
# 이 파일을 복사하여 .env로 사용하세요.
# cp .env.local.example .env

# ========== OpenAI ==========
OPENAI_API_KEY=your_openai_api_key_here

# ========== HuggingFace ==========
HF_TOKEN=your_hf_token_here

# ========== sLLM 설정 ==========
# 로컬 vLLM 서버 (WSL에서 실행)
# 시작 명령: wsl -e bash local_servers/start_sllm.sh
SIM_RUNPOD_URL=http://localhost:8000/v1
RUNPOD_API_KEY=dummy

# 텍스트 교정용 (RunPod - 8B 모델은 로컬 GPU 메모리 부족)
ACW_CORRECT_RUNPOD_URL=http://38.128.232.177:16362/v1
ACW_TYPE_RUNPOD_URL=http://38.128.232.177:16361/v1

# ========== TTS 설정 ==========
# TTS 엔진 선택: "edge" (로컬, 무료) 또는 "qwen3" (RunPod)
TTS_ENGINE=edge

# Edge-TTS 사용 시 아래 설정 불필요
# Qwen3-TTS 사용 시 아래 설정 필요
TTS_RUNPOD_URL=http://82.221.170.242:24476
TTS_TIMEOUT=15

# ========== Embedding ==========
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_REQUEST_DELAY=0.5

# ========== Database (PostgreSQL) ==========
DB_HOST=localhost
DB_PORT=5555
DB_USER=callact_admin
DB_PASSWORD=callact_pwd1
DB_NAME=callact_db

# ========== 로컬 모델 경로 ==========
MODEL_CACHE_DIR=./model_cache

# ========== RAG 캐시 (Redis) ==========
RAG_CARD_CACHE=1
RAG_CARD_CACHE_TTL=120
RAG_REDIS_URL=redis://localhost:6379/0
DIALOGUE_REDIS_URL=redis://localhost:6379/1
RAG_CARD_PROMPT_VERSION=v2-content-only
